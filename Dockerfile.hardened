# Build context is filtered by Dockerfile.hardened.dockerignore:
# .git, .env, node_modules, *.log never reach this build.
FROM node:22@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM gcr.io/distroless/nodejs22-debian13@sha256:c2753c8b3754b5bde34c1bbbaaa81b2e3ddd67604a867c3521257241f281ce0f
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY src/ ./src/
USER nonroot
EXPOSE 3000
CMD ["src/server.js"]
