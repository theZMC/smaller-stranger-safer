# Build context is filtered by Dockerfile.hardened.dockerignore:
# .git, .env, node_modules, *.log never reach this build.
FROM node:22@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM gcr.io/distroless/nodejs22-debian13@sha256:b55ac629fa389f4eb34ec53846bdefa081a9d25381fa1d37415414d623fe10ae
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY src/ ./src/
USER nonroot
EXPOSE 3000
CMD ["src/server.js"]
